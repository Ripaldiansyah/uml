' ============================================================
' S-05 · Lihat hasil diagnosa
' ============================================================
@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #0F0E17
skinparam ArrowThickness 1.2
skinparam LifeLineBorderColor #A7A9BE
skinparam SequenceGroupBorderColor #0F0E17
skinparam SequenceGroupBackgroundColor #FFF1E0
skinparam SequenceGroupFontStyle bold
skinparam ActorBorderColor #0F0E17
skinparam ActorBackgroundColor #FFFFFE
skinparam ParticipantBorderColor #0F0E17
skinparam ParticipantBackgroundColor #FFFFFE
skinparam shadowing false
autonumber

actor "Pengguna" as U
participant "Halaman hasil" as H
participant "Pengelola konsultasi" as S
participant "Basis data" as D

U -> H : Membuka halaman hasil
H -> S : Memeriksa hak akses konsultasi
alt tidak berhak atau tidak ada
    S --> U : Halaman tidak ditemukan atau akses ditolak
else berhak
    S -> D : Mengambil data motor, hasil, dan jejak penalaran
    D --> S : Data lengkap
    S --> H : Data konsultasi
    alt tidak ada kerusakan yang cocok
        H --> U : Pesan gejala belum cocok dan saran periksa langsung
    else ada kerusakan
        H --> U : Kerusakan, sparepart, perkiraan biaya, dan urutan penalaran
    end
end
@enduml
