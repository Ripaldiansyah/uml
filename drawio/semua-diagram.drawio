an aktif; bila belum ada, berikan penjelasan untuk menghubungi admin" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" connectable="1" parent="1"><mxGeometry x="430" y="360" width="250" height="58" as="geometry"/></mxCell><mxCell id="find" value="Cari aturan yang sesuai dan pilih pertanyaan yang belum terjawab" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" connectable="1" parent="1"><mxGeometry x="430" y="490" width="250" height="58" as="geometry"/></mxCell><mxCell id="more" value="Ada pertanyaan yang perlu dijawab?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" connectable="1" parent="1"><mxGeometry x="450" y="600" width="210" height="88" as="geometry"/></mxCell><mxCell id="answer" value="Jawab ya atau tidak; jawaban sebelumnya dapat diubah" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="70" y="760" width="220" height="58" as="geometry"/></mxCell><mxCell id="save" value="Simpan jawaban dan langkah pemeriksaan" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" connectable="1" parent="1"><mxGeometry x="430" y="760" width="250" height="58" as="geometry"/></mxCell><mxCell id="enough" value="Gangguan yang cocok sudah ditemukan?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" connectable="1" parent="1"><mxGeometry x="450" y="890" width="210" height="88" as="geometry"/></mxCell><mxCell id="cost" value="Hitung biaya jasa dan suku cadang