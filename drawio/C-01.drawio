<mxfile host="app.diagrams.net" agent="Dokumentasi AKC Workshop" version="24.7.17" type="device"><diagram id="class" name="Model, atribut, method, dan hubungan AKC Workshop"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="Setiap model memiliki kompartemen atribut dan method. Nama serta parameter method mengikuti implementasi PHP pada folder app." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;fontSize=14;align=center;verticalAlign=top;fontStyle=1;" vertex="1" connectable="0" parent="1"><mxGeometry x="70" y="20" width="1250" height="55" as="geometry"/></mxCell><mxCell id="user" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id, nama, username, email&lt;br&gt;Nomor HP dan kata sandi&lt;br&gt;Role dan status aktif&lt;br&gt;Waktu masuk terakhir&lt;br&gt;Waktu dibuat dan diubah&lt;hr&gt;&lt;u&gt;+ register(data: array): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ rules(ignoreId: ?int, passwordRequired: bool): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ update(id: int, data: array): void&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ withKonsultasiCount(): array&lt;/u&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="40" y="120" width="340" height="295" as="geometry"/></mxCell><mxCell id="history" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Konsultasi&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id, kode, user_id&lt;br&gt;Nama pemilik dan merek motor&lt;br&gt;Nomor kendaraan dan kilometer&lt;br&gt;Status: proses atau selesai&lt;br&gt;target_kerusakan_id dan kerusakan_id&lt;br&gt;rule_id yang menghasilkan diagnosis&lt;br&gt;Jawaban dan jejak pemeriksaan&lt;br&gt;total_biaya, waktu dibuat dan selesai&lt;hr&gt;&lt;u&gt;+ generateKode(): string&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ detail(id: int): ?array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ filtered(filter: array): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ update(id: int, data: array): void&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ stats(userId: ?int): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;- filterClause(f: array): array&lt;/u&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="435" y="110" width="445" height="415" as="geometry"/></mxCell><mxCell id="damage" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Kerusakan&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id, kode, nama&lt;br&gt;Deskripsi dan solusi&lt;br&gt;Jenis servis dan biaya jasa&lt;br&gt;Waktu dibuat&lt;hr&gt;&lt;u&gt;+ spareparts(kerusakanId: int): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ syncSpareparts(kerusakanId: int, items: array): void&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ estimasi(kerusakan: array): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ summary(): array&lt;/u&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="1010" y="120" width="370" height="280" as="geometry"/></mxCell><mxCell id="symptom" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Gejala&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id, kode, nama&lt;br&gt;Pertanyaan untuk pengguna&lt;br&gt;Kategori&lt;br&gt;Waktu dibuat&lt;hr&gt;&lt;u&gt;+ rules(ignoreId: ?int): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ keyed(): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ withUsage(): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ create(data: array): int&lt;/u&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="40" y="630" width="290" height="265" as="geometry"/></mxCell><mxCell id="rule" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Rule&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id, kode, kerusakan_id&lt;br&gt;Keterangan dan status aktif&lt;br&gt;Waktu dibuat&lt;hr&gt;&lt;u&gt;+ withPremis(onlyActive: bool): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ findWithPremis(id: int): ?array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ save(id: ?int, data: array, premisIds: array): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ duplicateOf(kerusakanId: int, premisIds: array): ?string&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ toText(rule: array, withNames: bool): string&lt;/u&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="435" y="620" width="445" height="305" as="geometry"/></mxCell><mxCell id="premise" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;rule_premis · tabel&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;rule_id, gejala_id&lt;br&gt;urutan pertanyaan&lt;br&gt;Unik pada setiap aturan&lt;br&gt;Premis diatur oleh Rule::save()." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" connectable="1" parent="1"><mxGeometry x="540" y="1010" width="300" height="140" as="geometry"/></mxCell><mxCell id="part" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Sparepart&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id, kode, nama&lt;br&gt;Satuan, harga, dan stok&lt;br&gt;Waktu dibuat&lt;hr&gt;&lt;u&gt;+ rules(ignoreId: ?int): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ withUsage(): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ lowStock(threshold: int): array&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ update(id: int, data: array): void&lt;/u&gt;" style="